# Dev-only placeholders. Copy to .env and fill in your own values; never commit .env.
DISCORDY_BOT_TOKEN=replace-with-your-bot-token
DISCORDY_APPLICATION_ID=000000000000000000
# Optional: register commands in one guild (instant) instead of globally.
DISCORDY_GUILD_ID=
# Optional: point at a local stack (Caddy ingress from gitops/local).
DISCORDY_API_URL=http://localhost:8000/api/v1
DISCORDY_GATEWAY_URL=ws://localhost:8000/gateway
