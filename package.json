{
  "name": "@discordy-voics/bots",
  "version": "0.1.0",
  "description": "Lean TypeScript SDK for building Discordy bots: gateway client, rate-limited REST, builders, interactions and webhooks.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discordy-voics/bots-sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
