# The SDK itself reads no environment variables; configuration is passed to `new Client({...})`.
# These dev-only placeholders are used by examples/moderation-bot (copy them to examples/moderation-bot/.env).
DISCORDY_BOT_TOKEN=replace-with-your-bot-token
DISCORDY_APPLICATION_ID=000000000000000000
DISCORDY_GUILD_ID=
DISCORDY_API_URL=http://localhost:8000/api/v1
DISCORDY_GATEWAY_URL=ws://localhost:8000/gateway
